{
  "name": "itmosoft/laravel-promotions",
  "description": "A reusable Laravel promotions package with coupons, discount campaigns, eligibility rules, and usage limits. Supports Laravel 12 and 13.",
  "type": "library",
  "license": "MIT",
  "require": {"php": "^8.3", "illuminate/contracts": "^12.0|^13.0", "illuminate/database": "^12.0|^13.0", "illuminate/support": "^12.0|^13.0"},
  "require-dev": {"orchestra/testbench": "^10.0|^11.0", "phpunit/phpunit": "^11.0|^12.0"},
  "autoload": {"psr-4": {"ItmoSoft\\Promotions\\": "src/"}},
  "autoload-dev": {"psr-4": {"ItmoSoft\\Promotions\\Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["ItmoSoft\\Promotions\\PromotionsServiceProvider"]}},
  "scripts": {"test": "phpunit"},
  "minimum-stability": "stable",
  "prefer-stable": true
}
